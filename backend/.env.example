# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Security Configuration (REQUIRED)
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secure-secret-key-here-replace-with-random-64-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# For development: include localhost origins
# For production: include your frontend domain (e.g., Vercel, Netlify, etc.)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://your-frontend-domain.vercel.app"]

# Database Configuration
DATABASE_URL=


# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=["image/jpeg","image/png","image/webp","image/gif"]
UPLOAD_FOLDER=uploads

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds