# -----------------------------
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.coverage.*
coverage/

# Environment Variables
# ---------------------
.env
.env.*
!.env.example
!.env.template

# Database Files
# --------------
*.db
*.sqlite
*.sqlite3
instance/

# Flask/FastAPI Specific
# ----------------------
instance/
.webassets-cache

# Jupyter Notebook
# ----------------
.ipynb_checkpoints

