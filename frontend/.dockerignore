# Next.js Frontend - .dockerignore
# =================================
# Includes all .gitignore entries plus Docker-specific optimizations

# ===== FROM .gitignore =====

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
.nyc_output
test-results/
playwright-report/
test-results.xml

# Next.js Build Outputs
/.next/
/out/
/.swc/

# Production Builds
/build
/dist

# Runtime Data
pids
*.pid
*.seed
*.pid.lock

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment Variables (Docker handles these differently)
.env*
!.env.example
!.env.template
!.env.local.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
.tsbuildinfo

# ESLint
.eslintcache

# Turbopack
.turbo

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-*
*.sublime-workspace
*.sublime-project

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp

# Backup Files
*.bak
*.backup
*.old

# Security
*.pem
*.key
*.p12
*.pfx

# Storybook
storybook-static
.storybook/public

# Temporary Folders
tmp/
temp/

# Editor Directories and Files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Development
.env.local
.env.development.local
.env.test.local
.env.production.local

# PWA Files
**/sw.js
**/workbox-*.js
**/worker-*.js

# Sentry
.sentryclirc

# Bundle Analyzer
.bundle-analyze/

# ===== DOCKER-SPECIFIC EXCLUSIONS =====

# Docker Files (don't copy docker files into image)
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore

# Git Repository (not needed in container)
.git/
.gitignore
.gitattributes
.gitmodules

# Development Dependencies (handled in Dockerfile)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Tools Config (not needed in production image)
.babelrc*
.eslintrc*
.prettierrc*
.stylelintrc*
webpack.config.js
rollup.config.js
vite.config.js
jest.config.js
cypress.json
playwright.config.js

# Development Tools
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in production image)
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
*.md
docs/
documentation/

# CI/CD Files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
Jenkinsfile
azure-pipelines.yml

# Testing Files and Directories
test/
tests/
__tests__/
spec/
specs/
cypress/
e2e/
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx

# Linting and Formatting
.eslintcache
.stylelintcache
.prettiercache

# Package Manager Files (dependencies handled in Dockerfile)
package-lock.json*
yarn.lock*
pnpm-lock.yaml*
.npmrc
.yarnrc*

# Source Maps (not needed in production)
**/*.map

# Coverage Reports
coverage/
.nyc_output

# Storybook
.storybook/
storybook-static/

# Local Development Servers
.next/
out/

# Large Files That Shouldn't Be in Container
*.zip
*.tar.gz
*.rar
*.7z

# Monitoring and Analytics
.sentryclirc
sentry.properties

# Performance
.bundle-analyze/
bundle-stats.json

# Security Scanners
.snyk

# Temporary Build Artifacts
*.tsbuildinfo
.swc/

# Kubernetes/Deployment
k8s/
kubernetes/
helm/
*.yaml
*.yml

# Environment-specific builds
build-dev/
build-staging/
build-test/