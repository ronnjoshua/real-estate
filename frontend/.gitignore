# Next.js Frontend - .gitignore
# ==============================

# Dependencies
# ------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package Manager Lock Files (keep these for reproducible builds)
# Keep: package-lock.json, yarn.lock, pnpm-lock.yaml

# Testing
# -------
/coverage
.nyc_output
test-results/
playwright-report/
test-results.xml

# Next.js Build Outputs
# ----------------------
/.next/
/out/
/.swc/

# Production Builds
# -----------------
/build
/dist

# Runtime Data
# ------------
pids
*.pid
*.seed
*.pid.lock

# Logs
# ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment Variables
# ---------------------
.env*
!.env.example
!.env.template
!.env.local.example

# Vercel
# ------
.vercel

# TypeScript
# ----------
*.tsbuildinfo
next-env.d.ts
.tsbuildinfo

# ESLint
# ------
.eslintcache

# Turbopack
# ---------
.turbo

# IDE and Editor Files
# --------------------
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-*
*.sublime-workspace
*.sublime-project

# OS Generated Files
# ------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp

# Backup Files
# ------------
*.bak
*.backup
*.old

# Security
# --------
*.pem
*.key
*.p12
*.pfx

# Storybook
# ---------
storybook-static
.storybook/public

# Temporary Folders
# -----------------
tmp/
temp/

# Editor Directories and Files
# -----------------------------
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Development
# -----------------
.env.local
.env.development.local
.env.test.local
.env.production.local

# PWA Files
# ---------
**/sw.js
**/workbox-*.js
**/worker-*.js

# Sentry
# ------
.sentryclirc

# Bundle Analyzer
# ---------------
.bundle-analyze/